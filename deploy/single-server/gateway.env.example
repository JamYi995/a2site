NODE_ENV=production
A2SITE_HOST=127.0.0.1
A2SITE_PORT=3320
A2SITE_TRUSTED_PROXIES=127.0.0.1,::1
A2SITE_SITE_ID=jamboxsys
A2SITE_SITE_NAME=果酱盒子
A2SITE_SITE_ORIGIN=https://jamboxsys.com
A2SITE_SITE_DESCRIPTION=果酱盒子面向外部 Agent 的开放接入层
A2SITE_OPERATOR_NAME=JamBox
A2SITE_ACTIONS_FILE=/etc/a2site/actions.json
A2SITE_ALLOW_INSECURE_LOCALHOST=false
A2SITE_DATABASE_URL=postgresql://a2site_app:replace-me@127.0.0.1:5432/a2site
A2SITE_AUTH_HASH_SECRET=replace-with-at-least-32-random-bytes
A2SITE_ALLOWED_SCOPES=manifest:read,identity:read
A2SITE_DEFAULT_SCOPES=manifest:read,identity:read
A2SITE_EMAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM_ADDRESS=agent@example.com
EMAIL_FROM_NAME=果酱盒子 A2Site
EMAIL_REPLY_TO=support@example.com
