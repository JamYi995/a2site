A2SITE_HOST=0.0.0.0
A2SITE_PORT=3200
A2SITE_SITE_ID=example-site
A2SITE_SITE_NAME=示例网站
A2SITE_SITE_ORIGIN=http://localhost:3200
A2SITE_SITE_DESCRIPTION=一个支持外部 Agent 自动发现的示例网站
A2SITE_OPERATOR_NAME=Example Operator
A2SITE_ALLOW_INSECURE_LOCALHOST=true
A2SITE_PGLITE_PATH=.data/a2site
A2SITE_AUTH_HASH_SECRET=local-development-only-a2site-hash-secret-change-me
A2SITE_ALLOWED_SCOPES=manifest:read,identity:read
A2SITE_DEFAULT_SCOPES=manifest:read,identity:read
A2SITE_EMAIL_MODE=console
# 生产环境使用 smtp，并通过仅服务器可读的环境文件设置以下变量：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=agent@example.com
# EMAIL_FROM_NAME=A2Site
# EMAIL_REPLY_TO=support@example.com
